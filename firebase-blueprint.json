{
  "entities": {
    "Comment": {
      "title": "Blog Comment",
      "description": "A comment left on a blog post.",
      "type": "object",
      "properties": {
        "postId": { "type": "string", "description": "The ID of the blog post." },
        "author": { "type": "string", "description": "Name of the commenter." },
        "role": { "type": "string", "description": "Professional role of the commenter." },
        "text": { "type": "string", "description": "The comment content." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the comment was created." },
        "isStaff": { "type": "boolean", "description": "Whether the comment is from a staff member." }
      },
      "required": ["postId", "author", "text", "createdAt"]
    },
    "Reply": {
      "title": "Comment Reply",
      "description": "A reply to a blog comment.",
      "type": "object",
      "properties": {
        "author": { "type": "string", "description": "Name of the replier." },
        "text": { "type": "string", "description": "The reply content." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the reply was created." },
        "isStaff": { "type": "boolean", "description": "Whether the reply is from a staff member." }
      },
      "required": ["author", "text", "createdAt"]
    },
    "BlogPost": {
      "title": "Blog Post",
      "description": "A blog post received from external AWS Lambda bot.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "The title of the blog post." },
        "content": { "type": "string", "description": "The markdown content of the blog post." },
        "author": { "type": "string", "description": "The author name." },
        "date": { "type": "string", "description": "Date of publication." },
        "status": { "type": "string", "description": "The publishing status (e.g., draft, published)." },
        "excerpt": { "type": "string", "description": "A quick summary excerpt." },
        "image": { "type": "string", "description": "Default illustrative image URL." },
        "tags": { "type": "array", "description": "A list of tags associated with this blog post." },
        "category": { "type": "string", "description": "The topic or category." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp if applicable." }
      },
      "required": ["title", "content"]
    },
    "ContactInquiry": {
      "title": "Contact Inquiry",
      "description": "A message sent via the contact form.",
      "type": "object",
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["firstName", "lastName", "email", "subject", "message", "createdAt"]
    }
  },
  "firestore": {
    "/blog_posts/{postId}": {
      "schema": "BlogPost",
      "description": "Blog posts received from the external AWS Lambda bot."
    },
    "/blog_comments/{commentId}": {
      "schema": "Comment",
      "description": "Public blog comments."
    },
    "/blog_comments/{commentId}/replies/{replyId}": {
      "schema": "Reply",
      "description": "Replies to blog comments."
    },
    "/contact_inquiries/{inquiryId}": {
      "schema": "ContactInquiry",
      "description": "Contact form submissions."
    }
  }
}
